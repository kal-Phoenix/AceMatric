# ── App Configuration ─────────────────────────────────────────────────────────
APP_URL="http://localhost:4000"
NODE_ENV="development"
# Comma-separated CORS allowlist. Required in production (never include localhost).
# Defaults to localhost:3000/4000 + acematric.com when unset.
ALLOWED_ORIGINS=""

# ── Redis (optional — rate-limit store + WebSocket multi-instance fan-out) ────
# Leave empty to run without Redis (in-memory rate limiting, single instance).
REDIS_URL=""

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL="your-supabase-url"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DIRECT_URL=""

# ── Auth & Security ──────────────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret"
ADMIN_EMAILS="admin@example.com"

# -- Social login (Google / Apple) -------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials (OAuth 2.0 Web client)
# Apple:  https://developer.apple.com/account (Services ID + Sign In with Apple)
# Redirect URI to register with Google: <your-origin>/api/auth/google/callback
# Leave empty to report the provider as "not configured" to the client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
APPLE_CLIENT_ID=""

# ── AI (Google Gemini) ──────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ── Contact Information ──────────────────────────────────────────────────────
CONTACT_PHONE="+251 9XX XXX XXX"
CONTACT_PHONE_HOURS="Mon-Sat, 8AM-9PM"
CONTACT_EMAIL="support@example.com"
CONTACT_EMAIL_REPLY="Reply within 30 minutes"
CONTACT_OFFICE="Your Office Address"
CONTACT_TELEGRAM="https://t.me/your_username"

# ── Pricing ──────────────────────────────────────────────────────────────────
PRO_MONTHLY_PRICE="299"
PRO_YEARLY_PRICE="1999"
PRO_CURRENCY="ETB"

# ── Payment Accounts ─────────────────────────────────────────────────────────
# CBE Birr
PAYMENT_CBE_BANK="Commercial Bank of Ethiopia (CBE)"
PAYMENT_CBE_ACCOUNT_NAME="Your Name"
PAYMENT_CBE_ACCOUNT_NUMBER="your-account-number"
PAYMENT_CBE_NOTE="Transfer 199 ETB (monthly) or 999 ETB (yearly)"

# Telebirr
PAYMENT_TELEBIRR_BANK="Telebirr (Ethio Telecom)"
PAYMENT_TELEBIRR_ACCOUNT_NAME="Your Name"
PAYMENT_TELEBIRR_ACCOUNT_NUMBER="your-phone-number"
PAYMENT_TELEBIRR_NOTE="Use the same phone number for transaction reference"

# Bank of Abyssinia
PAYMENT_BANK_BANK="Bank of Abyssinia"
PAYMENT_BANK_ACCOUNT_NAME="Your Name"
PAYMENT_BANK_ACCOUNT_NUMBER="your-account-number"
PAYMENT_BANK_NOTE="Include your full name in the transfer description"

# ── App Metadata ─────────────────────────────────────────────────────────────
APP_NAME="AceMatric"
APP_DESCRIPTION="All-in-one Matric exam preparation platform for Ethiopian Grade 12 students"
APP_TAGLINE="Ace your matric preparation"

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="your-resend-api-key"

# ── Error Tracking (Sentry) ──────────────────────────────────────────────────
SENTRY_DSN=""

# ── Push Notifications (VAPID) ──────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@acematric.edu.et"

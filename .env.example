# ── App Configuration ─────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL="your-supabase-url"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DIRECT_URL=""

# ── Auth & Security ──────────────────────────────────────────────────────────
JWT_SECRET="generate-a-strong-random-secret-min-32-chars"
ADMIN_EMAILS="admin@example.com"

# ── AI (Google Gemini) ──────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ── Contact Information ──────────────────────────────────────────────────────
CONTACT_PHONE="+251 911 223344"
CONTACT_PHONE_HOURS="Mon-Sat, 8AM-9PM"
CONTACT_EMAIL="support@acematric.edu.et"
CONTACT_EMAIL_REPLY="Reply within 30 minutes"
CONTACT_OFFICE="Bole Road, Mega Building 4F, Office 402, Addis Ababa"
CONTACT_TELEGRAM="https://t.me/acematric_et"

# ── Pricing ──────────────────────────────────────────────────────────────────
PRO_MONTHLY_PRICE="199"
PRO_YEARLY_PRICE="999"
PRO_CURRENCY="ETB"

# ── Payment Accounts ─────────────────────────────────────────────────────────
PAYMENT_CBE_BANK="Commercial Bank of Ethiopia (CBE)"
PAYMENT_CBE_ACCOUNT_NAME="AceMatric PLC"
PAYMENT_CBE_ACCOUNT_NUMBER="your-cbe-account"
PAYMENT_CBE_NOTE="Transfer exactly 199 ETB (monthly) or 999 ETB (yearly)"

PAYMENT_TELEBIRR_BANK="Telebirr (Ethio Telecom)"
PAYMENT_TELEBIRR_ACCOUNT_NAME="AceMatric PLC"
PAYMENT_TELEBIRR_ACCOUNT_NUMBER="your-telebirr-number"
PAYMENT_TELEBIRR_NOTE="Use the same phone number for transaction reference"

PAYMENT_BANK_BANK="Bank of Abyssinia"
PAYMENT_BANK_ACCOUNT_NAME="AceMatric PLC"
PAYMENT_BANK_ACCOUNT_NUMBER="your-abyssinia-account"
PAYMENT_BANK_NOTE="Include your full name in the transfer description"

# ── App Metadata ─────────────────────────────────────────────────────────────
APP_NAME="AceMatric"
APP_DESCRIPTION="All-in-one Matric exam preparation platform for Ethiopian Grade 12 students"
APP_TAGLINE="Ace your matric preparation"

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="your-resend-api-key"

# ── Error Tracking (Sentry) ──────────────────────────────────────────────────
SENTRY_DSN=""

# ── Push Notifications (VAPID) ──────────────────────────────────────────────

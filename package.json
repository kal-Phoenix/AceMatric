{
  "name": "acematric",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "revise": "tsx server/revise-content.ts",
    "import-revised": "tsx server/import-revised.ts",
    "fix-answers": "tsx server/fix-past-exam-answers.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
